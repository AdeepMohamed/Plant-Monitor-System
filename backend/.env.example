# PlantCare AI Backend Environment Configuration

# Neon PostgreSQL connection string (or SQLite default)
# Example Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=sqlite:///./plantcare.db

# Security & JWT Token signing
SECRET_KEY=plantcare-ai-super-secret-production-key-2026-safe

# Google Gemini Multimodal Vision API Key
# Obtain free from https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Vision & Language Model
GEMINI_MODEL=gemini-2.5-flash
